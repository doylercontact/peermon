#!/usr/bin/env python3
"""peermonctl - query a peermon node, and report cleanly when it can't be reached.

By default it queries the PEER named in /etc/peermon.env, so on vm-a it asks
vm-b and vice versa. If the target can't be reached:
  health, neighbor   report the target as down (plus this node's view of it)
  events, history    fall back to THIS node's records, which show the peer
                     going down, and append a final "peer_down" entry
  status             one-line summary of both views

Standard library only; no virtualenv needed.
Exit code: 0 = target reachable, 1 = target down, 2 = usage error.
"""
import argparse
import json
import socket
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

ENV_FILE = "/etc/peermon.env"
LOCAL_URL = "http://127.0.0.1:8000"

EVENT_COLS = ["id", "ts_utc", "event", "detail"]
CHECK_COLS = ["seq", "ts_utc", "ok", "latency_ms", "error", "peer_boot_id", "clock_skew_ms"]


# --- helpers ------------------------------------------------------------------
def load_env(path=ENV_FILE):
    env = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    key, value = line.split("=", 1)
                    env[key.strip()] = value.strip()
    except OSError:
        pass
    return env


def utcnow():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds")


class Down(Exception):
    def __init__(self, reason, detail=""):
        super().__init__(reason)
        self.reason, self.detail = reason, detail


def fetch(base, path, timeout):
    """GET base+path and return parsed JSON, or raise Down(reason)."""
    try:
        with urllib.request.urlopen(base.rstrip("/") + path, timeout=timeout) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        raise Down("http_error", f"HTTP {e.code}")
    except urllib.error.URLError as e:
        reason = e.reason
        if isinstance(reason, ConnectionRefusedError):
            raise Down("refused", "nothing listening: VM up, app down")
        if isinstance(reason, (TimeoutError, socket.timeout)):
            raise Down("timeout", "no answer: VM or network down")
        raise Down("unreachable", str(reason))
    except (TimeoutError, socket.timeout):
        raise Down("timeout", "no answer: VM or network down")
    except ConnectionRefusedError:
        raise Down("refused", "nothing listening: VM up, app down")
    except (ConnectionError, OSError, ValueError) as e:
        raise Down("unreachable", str(e))


def short_ts(ts):
    return ts[:23].replace("T", " ") if isinstance(ts, str) else ts


# --- output -------------------------------------------------------------------
def render_table(rows, cols):
    cells = [[("-" if r.get(c) is None else str(short_ts(r.get(c)) if c == "ts_utc" else r.get(c)))
              for c in cols] for r in rows]
    widths = [max([len(c)] + [len(row[i]) for row in cells]) for i, c in enumerate(cols)]
    lines = ["  ".join(c.ljust(w) for c, w in zip(cols, widths)),
             "  ".join("-" * w for w in widths)]
    lines += ["  ".join(v.ljust(w) for v, w in zip(row, widths)).rstrip() for row in cells]
    return "\n".join(lines)


def render_kv(d, indent=""):
    out = []
    width = max((len(k) for k in d), default=0)
    for k, v in d.items():
        if isinstance(v, dict):
            out.append(f"{indent}{k}:")
            out.append(render_kv(v, indent + "  "))
        else:
            out.append(f"{indent}{k.ljust(width)}  {'-' if v is None else v}")
    return "\n".join(out)


def emit(data, args, rows_key=None, cols=None):
    if args.table:
        if rows_key:
            header = {k: v for k, v in data.items() if k != rows_key}
            print("# " + "  ".join(f"{k}={v}" for k, v in header.items()))
            print(render_table(data.get(rows_key, []), cols))
        else:
            print(render_kv(data))
    elif args.pretty:
        print(json.dumps(data, indent=2))
    else:
        print(json.dumps(data, separators=(",", ":")))


# --- commands -----------------------------------------------------------------
def local_view(args):
    """This node's own /neighbor, if we are on a peermon node and it isn't the target."""
    if args.target_is_local:
        return None
    try:
        return fetch(LOCAL_URL, "/neighbor", args.timeout)
    except Down:
        return None


def down_record(args, err):
    return {"node": args.target_name, "url": args.target, "status": "down",
            "reason": err.reason, "detail": err.detail, "checked_utc": utcnow()}


def cmd_health(args):
    try:
        emit(fetch(args.target, "/health", args.timeout), args)
        return 0
    except Down as err:
        emit(down_record(args, err), args)
        return 1


def cmd_neighbor(args):
    try:
        emit(fetch(args.target, "/neighbor", args.timeout), args)
        return 0
    except Down as err:
        rec = down_record(args, err)
        view = local_view(args)
        if view:
            rec["seen_from"] = {k: view.get(k) for k in (
                "node", "peer_status", "status_since_utc", "consecutive_failures",
                "last_success_utc", "last_failure_utc")}
        emit(rec, args)
        return 1


def cmd_rows(args, path, rows_key, cols, synth):
    query = f"?minutes={args.minutes}" + (f"&limit={args.limit}" if path == "/history" else "")
    try:
        data, rc = fetch(args.target, path + query, args.timeout), 0
    except Down as err:
        rc, data = 1, None
        if not args.target_is_local:
            try:
                data = fetch(LOCAL_URL, path + query, args.timeout)
                data["source"] = f"local fallback: {args.target_name} is down"
            except Down:
                data = None
        if data is None:
            data = {"node": args.target_name, "source": "target down, no local records", rows_key: []}
        data[rows_key].append(synth(args, err))
    if args.last:
        data[rows_key] = data[rows_key][-args.last:]
    emit(data, args, rows_key, cols)
    return rc


def synth_event(args, err):
    return {"id": None, "ts_utc": utcnow(), "event": "peer_down",
            "detail": f"{args.target_name} unreachable from peermonctl: {err.reason} ({err.detail})"}


def synth_check(args, err):
    return {"seq": None, "ts_utc": utcnow(), "ok": 0, "latency_ms": None, "http_status": None,
            "error": err.reason, "peer_boot_id": None, "clock_skew_ms": None,
            "note": "synthesized by peermonctl"}


def cmd_status(args):
    try:
        t = fetch(args.target, "/neighbor", args.timeout)
        rc = 0
        last = t.get("last_check") or {}
        lat = f"{last.get('latency_ms')} ms" if last.get("ok") else last.get("error")
        lines = [f"{t['node']}: UP  -  sees {t['peer']} {t['peer_status'].upper()} "
                 f"since {short_ts(t['status_since_utc'])}  (last check: {lat})"]
        summary = {"target": t["node"], "target_status": "up",
                   "target_sees_peer": t["peer_status"], "since_utc": t["status_since_utc"]}
    except Down as err:
        rc = 1
        lines = [f"{args.target_name}: DOWN  -  {err.reason} ({err.detail})"]
        summary = {"target": args.target_name, "target_status": "down", "reason": err.reason}
        view = local_view(args)
        if view:
            lines.append(f"{view['node']}: sees {view['peer']} {view['peer_status'].upper()} "
                         f"since {short_ts(view['status_since_utc'])}  "
                         f"({view['consecutive_failures']} consecutive failures)")
            summary["seen_from"] = {"node": view["node"], "peer_status": view["peer_status"],
                                    "since_utc": view["status_since_utc"]}
    if args.pretty or args.json:
        emit(summary, args)
    else:
        print("\n".join(lines))
    return rc


COMMANDS = {
    "status": cmd_status,
    "health": cmd_health,
    "neighbor": cmd_neighbor,
    "events": lambda a: cmd_rows(a, "/events", "events", EVENT_COLS, synth_event),
    "history": lambda a: cmd_rows(a, "/history", "checks", CHECK_COLS, synth_check),
}


def main():
    p = argparse.ArgumentParser(
        prog="peermonctl",
        description="Query a peermon node; report cleanly when it can't be reached.",
        epilog="examples:\n"
               "  peermonctl status\n"
               "  peermonctl neighbor --pretty\n"
               "  peermonctl events --table --minutes 60\n"
               "  peermonctl history --table --last 20\n"
               "  peermonctl status --watch 5\n"
               "  peermonctl events --local --pretty\n"
               "  peermonctl health --host http://10.0.2.10:8000",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("command", choices=COMMANDS.keys())
    target = p.add_mutually_exclusive_group()
    target.add_argument("--peer", action="store_true", help="query the peer from /etc/peermon.env (default)")
    target.add_argument("--local", action="store_true", help="query this node (http://127.0.0.1:8000)")
    target.add_argument("--host", metavar="URL", help="query any node, e.g. http://10.0.2.10:8000")
    fmt = p.add_mutually_exclusive_group()
    fmt.add_argument("--pretty", action="store_true", help="indented JSON (like jq)")
    fmt.add_argument("--table", action="store_true", help="human-readable table / key-value view")
    fmt.add_argument("--json", action="store_true", help="compact JSON (default, except status)")
    p.add_argument("--minutes", type=int, default=30, help="events/history window (default 30)")
    p.add_argument("--limit", type=int, default=5000, help="history row limit (default 5000)")
    p.add_argument("--last", type=int, metavar="N", help="show only the last N events/history rows")
    p.add_argument("--timeout", type=float, default=3, help="seconds before the target counts as down (default 3)")
    p.add_argument("--watch", type=float, metavar="SECONDS", help="repeat every N seconds until Ctrl-C")
    args = p.parse_args()

    env = load_env()
    if args.host:
        args.target, args.target_name = args.host, args.host
    elif args.local or not env.get("PEER_URL"):
        args.target, args.target_name = LOCAL_URL, env.get("NODE_NAME", "local")
    else:
        args.target, args.target_name = env["PEER_URL"], env.get("PEER_NAME", env["PEER_URL"])
    args.target_is_local = args.target.rstrip("/") in (LOCAL_URL, "http://localhost:8000")

    run = COMMANDS[args.command]
    if not args.watch:
        sys.exit(run(args))
    try:
        while True:
            print(f"--- {utcnow()}")
            run(args)
            sys.stdout.flush()
            time.sleep(args.watch)
    except KeyboardInterrupt:
        sys.exit(0)


if __name__ == "__main__":
    main()
