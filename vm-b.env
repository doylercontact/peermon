NODE_NAME=vm-b
SITE=B
PEER_NAME=vm-a
PEER_URL=http://<vm-a-ip>:8000
CHECK_INTERVAL=5
CHECK_TIMEOUT=2
FAIL_THRESHOLD=3
DB_PATH=/var/lib/peermon/checks.db
RETENTION_HOURS=72
# Extra hosts allowed to reach port 8000 when the host firewall is enabled
# (space-separated IPs, CIDRs or hostnames; the peer is always allowed)
FIREWALL_ALLOW=
